{
  "manifest_version": 3,
  "name": "Job Tracker — Posting Closed",
  "version": "0.1.0",
  "description": "Mark the existing Job Tracker application for this exact URL as Posting Closed.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mark posting closed in Job Tracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://tracker.example/*"]
}
